---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const wikiEntries = await getCollection("wiki");
  return wikiEntries
    .filter((entry) => !["scaling-difficult", "eazzy-server-utils", "safety-zstones", "server"].includes(entry.id))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const categoryLabels: Record<string, string> = {
  server: "Server",
  "scaling-difficult": "Scaling Difficult",
  "eazzy-server-utils": "Eazzy Server Utils",
  "safety-zstones": "Safety ZStones",
};

const categoryAccent: Record<string, string> = {
  server: "text-blue-400 border-blue-400/40 bg-blue-400/10",
  "scaling-difficult": "text-red-400 border-red-400/40 bg-red-400/10",
  "eazzy-server-utils": "text-emerald-400 border-emerald-400/40 bg-emerald-400/10",
  "safety-zstones": "text-orange-400 border-orange-400/40 bg-orange-400/10",
};

const accentClass = categoryAccent[entry.data.category] ?? "text-primary border-primary/40 bg-primary/10";
---

<Layout
  title={`${entry.data.title} | Wiki | Summer Fantasy`}
  description={entry.data.description}
>
  <article class="py-12">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mb-8">
        <a
          href="/wiki"
          class="inline-flex items-center gap-2 border-2 border-border bg-card px-4 py-2 text-sm font-bold uppercase tracking-wider text-muted-foreground transition-colors hover:border-primary hover:text-primary"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          Volver a la wiki
        </a>
      </div>

      <header class="reveal mb-10">
        <span class={`inline-block border px-3 py-1 text-xs font-bold uppercase tracking-wider ${accentClass}`}>
          {categoryLabels[entry.data.category] ?? entry.data.category}
        </span>
        <h1 class="mt-4 text-4xl font-bold text-foreground sm:text-5xl" style={{ fontFamily: 'var(--font-heading)' }}>
          {entry.data.title}
        </h1>
        <p class="mt-3 text-lg text-muted-foreground">{entry.data.description}</p>
      </header>

      <div class="reveal dungeon-panel p-5 sm:p-8">
        <div class="prose max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Layout>
